---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects, site } from '../data/site';

const research = projects.filter(p => p.category === 'research');
const current = research.filter(p => p.current);
const past = research.filter(p => !p.current);

const author = { "@type": "Person", name: site.name, url: site.url };

const aiTestPaperSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  name: "Fixing Performance Bugs Through LLM Explanations",
  author,
  isPartOf: {
    "@type": "PublicationEvent",
    name: "7th IEEE International Conference on Artificial Intelligence Testing (AITest 2025)",
    publishedBy: { "@type": "Organization", name: "IEEE" }
  },
  datePublished: "2025-07-22",
  identifier: "10.1109/AITest66680.2025.00020",
  url: "https://doi.org/10.1109/AITest66680.2025.00020"
};

const lctesPaperSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  name: "Scheduled Partial-Credit RL for Reliable Code Generation with Small Language Models (WIP)",
  alternateName: "SecureCodeRL",
  author,
  isPartOf: {
    "@type": "PublicationEvent",
    name: "27th ACM SIGPLAN/SIGBED International Conference on Languages, Compilers, and Tools for Embedded Systems (LCTES 2026)",
    publishedBy: { "@type": "Organization", name: "ACM" },
    location: "Boulder, Colorado, United States"
  },
  datePublished: "2026",
  identifier: "10.1145/3814943.3816167",
  url: "https://doi.org/10.1145/3814943.3816167"
};

const ictaiPaperSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  name: "Continuous Retrieval-Grounded Reward Design for Secure Code Generation on Small Language Models (CARGO)",
  alternateName: "CARGO",
  author,
  isPartOf: {
    "@type": "PublicationEvent",
    name: "IEEE International Conference on Tools with Artificial Intelligence (ICTAI 2026)",
    publishedBy: { "@type": "Organization", name: "IEEE" }
  },
  datePublished: "2026",
  url: "https://github.com/SuryanshSS1011/SecureCodeRL-RAG"
};

const matchLossPaperSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  name: "Match Your Loss to Your Cost: Asymmetric Losses and Conformal Capacity Bands for Backbone Traffic Forecasting",
  author,
  dateCreated: "2026-06-01",
  url: "https://github.com/SuryanshSS1011/match-loss-to-cost"
};

const allPaperSchemas = [aiTestPaperSchema, lctesPaperSchema, ictaiPaperSchema, matchLossPaperSchema];
---

<BaseLayout
  title="Research · Suryansh Sijwali"
  description="Peer-reviewed research by Suryansh Sijwali (Patishnock Undergraduate Research Award, Penn State). Fixing Performance Bugs Through LLM Explanations (IEEE AITest 2025), Scheduled Partial-Credit RL for Reliable Code Generation with SLMs (WIP) (LCTES 2026), Continuous Retrieval-Grounded Reward Design for Secure Code Generation on SLMs (CARGO) (ICTAI 2026), Match Your Loss to Your Cost: Asymmetric Losses and Conformal Capacity Bands for Backbone Traffic Forecasting."
  jsonLd={allPaperSchemas}
>
  <SectionHeading
    label="research"
    title="Papers and ongoing investigations"
    description="Peer-reviewed work, work-in-progress papers, and research-grade builds."
    level="h1"
  />

  {current.length > 0 && (
    <section>
      <p class="section-label">Current</p>
      <div class="index-list">
        {current.map((project) => (
          <ProjectRow project={project} detailed />
        ))}
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section>
      <p class="section-label">Recent</p>
      <div class="index-list">
        {past.map((project) => (
          <ProjectRow project={project} detailed />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
