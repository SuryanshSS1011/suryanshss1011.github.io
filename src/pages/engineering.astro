---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects } from '../data/site';

const engineering = projects.filter(p => p.category === 'engineering');
const current = engineering.filter(p => p.current);
const past = engineering.filter(p => !p.current);
---

<BaseLayout
  title="Engineering · Suryansh Sijwali"
  description="Engineering projects by Suryansh Sijwali. Currently building Warren (Wikipedia rabbit-hole map). Past: Wynlabs (founding engineer, industrial AI copilot), a Morgan Advanced Materials-sponsored citation-grounded RAG capstone, TruthCast (HackPSU Solana track winner), Shift (GDG climate track winner)."
>
  <SectionHeading
    label="engineering"
    title="Industry systems and shipped builds"
    description="Production AI work, founding-engineer projects, and hackathon builds."
    level="h1"
  />

  {current.length > 0 && (
    <section>
      <p class="section-label">Building now</p>
      <div class="index-list">
        {current.map((project) => (
          <ProjectRow project={project} detailed />
        ))}
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section>
      <p class="section-label">Shipped</p>
      <div class="index-list">
        {past.map((project) => (
          <ProjectRow project={project} detailed />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
