---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostListItem from '../components/PostListItem.astro';
import { site, about, projects } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    if (a.data.pinBottom !== b.data.pinBottom) {
      return a.data.pinBottom ? 1 : -1;
    }
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);

// The home page is an index, not a portfolio dump. Papers carry the whole
// record because that is the differentiating credential; builds show only the
// featured set. Depth lives on /research and /engineering.
const papers = projects.filter(p => p.category === 'research');
const builds = projects.filter(p => p.category === 'engineering' && p.featured);

const ed = about.education;
---

<BaseLayout
  title={`${site.name} · ${site.title}`}
  description={site.description}
>
  <section class="profile">
    <h1>{site.name}</h1>
    <p class="subtitle">{site.subtitle}</p>
    <p class="credentials">{site.credentials}</p>
    <dl class="status">
      <div class="status-row">
        <dt>Currently working on</dt>
        <dd>{about.currently}</dd>
      </div>
      <div class="status-row">
        <dt>Recently submitted</dt>
        <dd>{about.submitted}</dd>
      </div>
      <div class="status-row">
        <dt>Open source</dt>
        <dd>{about.openSource}</dd>
      </div>
    </dl>
    <p class="closing-line">{site.closingLine}</p>

    <div class="links">
      <a href={site.social.github} target="_blank" rel="noopener">GitHub</a>
      <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.social.orcid} target="_blank" rel="noopener">ORCID</a>
      <a href={site.social.scholar} target="_blank" rel="noopener">Scholar</a>
      <a href={`mailto:${site.social.email}`}>Email</a>
    </div>
  </section>

  <section>
    <SectionHeading label="research" />
    <div class="index-list">
      {papers.map((project) => (
        <ProjectRow project={project} />
      ))}
    </div>
    <p class="section-more"><a href="/research">All research →</a></p>
  </section>

  <section>
    <SectionHeading label="engineering" />
    <div class="index-list">
      {builds.map((project) => (
        <ProjectRow project={project} />
      ))}
    </div>
    <p class="section-more"><a href="/engineering">All engineering →</a></p>
  </section>

  <section>
    <SectionHeading label="writing" />
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <PostListItem post={post} showExcerpt={false} />
        ))}
      </ul>
    ) : (
      <p class="text-muted">Coming soon.</p>
    )}
    <p class="section-more"><a href="/blog">All writing →</a></p>
  </section>

  <section>
    <SectionHeading label="education" />
    <dl class="ed-grid">
      <dt>degree</dt>
      <dd>{ed.degree} · {ed.graduation}</dd>

      <dt>school</dt>
      <dd>{ed.institution}</dd>

      <dt>colleges</dt>
      <dd>{ed.colleges.join(' · ')}</dd>

      <dt>minors</dt>
      <dd>{ed.minors.join(' · ')}</dd>
    </dl>
  </section>
</BaseLayout>
